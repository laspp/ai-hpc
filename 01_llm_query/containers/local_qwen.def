Bootstrap: docker
From: pytorch/pytorch:2.12.0-cuda12.6-cudnn9-runtime

%arguments
    MODEL=Qwen/Qwen2.5-0.5B-Instruct

%labels
    Application local-qwen
    Version     1.0
    Description Container for running Qwen2.5-0.5B-Instruct model queries locally, 
                with model weights baked into the image at build time.

%files
    ../query_model.py    /opt/app/query_model.py
    ../requirements.txt  /opt/app/requirements.txt

%post
    set -e
    apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
    pip install --break-system-packages --no-cache-dir --upgrade pip
    pip install --break-system-packages --no-cache-dir -r /opt/app/requirements.txt

    export HF_HOME=/opt/app/hf-cache
    mkdir -p "$HF_HOME"
    # Download the model now, at build time
    python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='{{ MODEL }}')"

%environment
    export HF_HOME=/opt/app/hf-cache
    export PYTHONUNBUFFERED=1
    export HF_HUB_OFFLINE=1

%runscript
    exec python /opt/app/query_model.py --model {{ MODEL }} "$@"

%test
    set -e
    ls -d "$HF_HOME"/hub/models--* >/dev/null 2>&1 || { echo "No model in cache"; exit 1; }
    du -sh "$HF_HOME"

%help
    Build the container (downloads {{ MODEL }}):
        apptainer build local_qwen_latest.sif local_qwen.def

    Build with a different model baked in:
        apptainer build --build-arg MODEL=cjvt/GaMS-2B-Instruct \
            local_qwen_latest.sif local_qwen.def

    Run (CPU):
        apptainer run local_qwen_latest.sif \
            --prompt "What is the capital of Slovenia?"

    Run (GPU):
        apptainer run --nv local_qwen_latest.sif \
            --prompt "Explain KV-cache in one sentence." --max-new-tokens 64
